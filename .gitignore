# Deny unrelated material at the workspace root; add source roots explicitly.
/*
!/.gitignore
!/.env.example
!/README.md
!/README_HARNESS.md
!/HANDOFF.md
!/HARNESS_FREEZE.md
!/harness_freeze.json
!/CITATION.cff
!/LICENSE
!/experiments/
!/requirements.txt
!/requirements-harness.txt
!/requirements-lock.txt
!/pytest.ini
!/__init__.py
!/adj_partner/
!/core/
!/legacy/
!/environment/
!/tests/
!/scripts/
!/eval/
!/config/
!/docs/
!/.github/
!/trace_dashboard/

# Only public config/contracts; full old records remain in the local backup.
/config/*
!/config/llm.yaml
!/config/settings.yaml
!/config/sources.yaml
!/config/research-resource-index.json
!/config/skills/
/docs/*
!/docs/ROOT_MIGRATION.md
!/docs/architecture/
!/docs/refactor_2026-08-31/
!/docs/superpowers/
/docs/refactor_2026-08-31/*
!/docs/refactor_2026-08-31/*_CONTRACT.md
!/docs/refactor_2026-08-31/*_API.md
!/docs/refactor_2026-08-31/data-baseline.json
!/docs/refactor_2026-08-31/protein-baseline.json
!/docs/refactor_2026-08-31/dataset-before.sha256
/docs/superpowers/*
!/docs/superpowers/plans/
!/docs/superpowers/specs/
/docs/superpowers/plans/*
!/docs/superpowers/plans/2026-08-31-root-publication.md
!/docs/superpowers/plans/2026-09-02-open-research-trace-dashboard.md
/docs/superpowers/specs/*
!/docs/superpowers/specs/2026-09-02-open-research-trace-dashboard-design.md
!/docs/superpowers/specs/2026-09-06-adjuvant-design-workflow.md

# Ignore is not a substitute for checking staged bytes and commit history.
.env
.env.*
*.env
!/.env.example
*.local.*
*.key
*.pem
*.p12
*.pfx
*.keystore
credentials
credentials.*
secrets
secrets.*
.ssh/
.aws/
.gnupg/
.netrc
.npmrc
.pypirc
.git-credentials
id_rsa
id_dsa
id_ecdsa
id_ed25519
workspace/
workspaces/
archive/
/eval/deep_research_bench/
/eval/cot.txt
harness-state/
.harness-state/
state/
evaluations/
results/
deliveries/
*.log
*.sqlite*
*.db
*.db-*
*.csv
*.parquet
*.xlsx
*.pdf
*.zip
*.tar.gz
environment/data_lake/*
!environment/data_lake/.gitkeep
environment/corpus_index/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
.DS_Store

# Manuscript figures are vector PDFs rendered from aggregate numbers only.
!/experiments/figures/*.pdf

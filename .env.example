# Empty public template. Real credentials and private endpoint/model choices stay local.
# Copy to .einwang_env (mode 600); scripts/adj and scripts/with-env load it, .env is a hard link to it.
# The harness library and scripts/adj-partner read it ONLY when passed explicitly via --env-file.
# Do not paste credentials into conversations, tool inputs, reports or traces.
ADJ_LLM_API_KEY=
ADJ_LLM_BASE_URL=
ADJ_LLM_MODEL=

# Optional Adj Partner runtime defaults. Empty means the built-in value shown.
# Explicit CLI flags override process environment, which overrides this file.
# Per model request; these are read by every run/resume/tui process.
# Built-in: 4096
ADJ_PARTNER_REQUEST_OUTPUT_TOKENS=
# Built-in: 120 seconds
ADJ_PARTNER_REQUEST_TIMEOUT_SECONDS=

# New-session cumulative budget; values are persisted when `new` creates a session.
# Built-in: 24 model requests
ADJ_PARTNER_MAX_STEPS=
# Built-in: 120000 input tokens
ADJ_PARTNER_MAX_INPUT_TOKENS=
# Built-in: 24000 output tokens
ADJ_PARTNER_MAX_OUTPUT_TOKENS=
# Built-in: 600 seconds
ADJ_PARTNER_WALL_TIME_SECONDS=

# Security boundary: network, file roots, tools, dataset paths and MCP servers
# remain explicit CLI options and cannot be enabled through these defaults.

# Optional host integrations; values configure capability availability but do
# not grant network access. A session still needs `new --allow-network`.
# Set ADJ_WEB_SEARCH_PROVIDER=mwmbl for anonymous web search. No key is used.
# Mwmbl advertises 1 request/second and 1,000/month per IP (developer.mwmbl.org).
# Serper and Tavily require a key and explicit provider selection.
# Search results contain titles and snippets. The host archives the raw API
# response. Empty configuration disables the tool. Failed requests are not retried.
ADJ_WEB_SEARCH_PROVIDER=
ADJ_WEB_SEARCH_API_KEY=
# Provider-specific keys take precedence over the legacy generic key. Keeping
# separate values permits safe rotation without rewriting an existing secret.
ADJ_SERPER_API_KEY=
ADJ_TAVILY_API_KEY=

# Optional AI Hub pass-through gateway (internal network). Selecting
# ADJ_WEB_SEARCH_PROVIDER=serper_gateway routes web_search through it; the
# gateway resolves Google goto links (up to ~60 s). A comma list such as
# serper_gateway,serper,mwmbl is an ordered fallback chain: a provider failure
# moves to the next one, and later providers without credentials are skipped.
# There is no built-in address: the gateway providers need ADJ_AIHUB_GATEWAY_URL.
ADJ_AIHUB_GATEWAY_URL=
ADJ_SERPER_GATEWAY_APP_ID=
ADJ_SERPER_GATEWAY_APP_KEY=
# web_page_read backend: empty or curl = pinned local curl + static HTML parser;
# jina_gateway = Jina Reader via the gateway (rendered page as Markdown), falling
# back to the local curl reader when Jina fails.
ADJ_WEB_PAGE_READER=
ADJ_JINA_GATEWAY_APP_ID=
ADJ_JINA_GATEWAY_APP_KEY=

# Optional scholarly metadata/OA configuration. Europe PMC, PubMed and Crossref
# metadata search work without API keys. An NCBI key raises the service-side
# request allowance; emails are provider contact metadata, not agent permissions.
# Unpaywall lookup is enabled only when its contact email is explicitly set.
ADJ_NCBI_API_KEY=
ADJ_NCBI_EMAIL=
ADJ_UNPAYWALL_EMAIL=

# Optional legacy/reviewer integrations; not required by the harness offline demo.
ADJ_ALLOW_CODE_EXEC=0
ADJ_REVIEWER_API_KEY=
ADJ_REVIEWER_BASE_URL=
ADJ_REVIEWER_MODEL=
ADJ_GOOGLE_CSE_ID=
ADJ_SEMANTIC_SCHOLAR_API_KEY=

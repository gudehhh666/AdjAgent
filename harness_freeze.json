{
  "release": "release-v0.2",
  "frozen_at": "2026-11-13",
  "contents": "code only; results, evaluation sets, gold answers and resource packs are not included",
  "rule": "Slots change only through the replacement protocol below. Code and host-file drift is detected by `scripts/harness_freeze.py verify`.",
  "pillars": {
    "count": 3,
    "P1": "Experience integration: typed resource packs (14 datasets, 12,530 records), a local literature library and sandboxed computation.",
    "P2": "Evidence-bound reasoning: source -> evidence -> claim -> report with host citation gating.",
    "P3": "Mechanism graphs: competing hypotheses, an edge-level citation gate, value/cost ranking and the wet/dry feedback loop.",
    "feedback_loop": "Cross-cutting, not a separate pillar: P1 draft -> compute -> verify -> revise; P2 draft -> retrieve -> revise or keep -> anchor self-check; P3 rank -> readout -> graph propagation and pruning -> replan."
  },
  "shared": {
    "solver_model": "gpt-5.6-luna",
    "endpoint": "OpenAI-compatible endpoint from ADJ_LLM_BASE_URL",
    "web_search_chain": "ADJ_WEB_SEARCH_PROVIDER=serper_gateway,serper,mwmbl",
    "page_reader": "ADJ_WEB_PAGE_READER=jina_gateway",
    "pubmed": "ADJ_NCBI_API_KEY + ADJ_NCBI_EMAIL, timeout 45 s, one retry; on second failure fall back to Serper gateway",
    "judges": {
      "judge": "gpt-4o-2024-11-20",
      "forbidden": "gpt-4o-mini no longer used for new results; gpt-5.6-* and gpt-6-* never judge (same family as the solver)"
    },
    "token_cap": 400000000,
    "evaluation": "same-question paired difference (harness - direct), question-level bootstrap 95% CI, win/tie/loss, tokens per arm",
